{
  "manifest_version": 1,
  "id": "dev.bygram.composer",
  "name": "Draft uppercase",
  "description": "Preview an uppercase draft in the current chat, then apply explicitly.",
  "version": "1.0.0",
  "author": "BYgram SDK example",
  "entrypoint": "main.py:ComposerPlugin",
  "sdk": {"min": 1, "max": 1},
  "python": "3.11",
  "capabilities": ["ui", "messages.observe", "messages.send"],
  "account_scope": "selected_accounts",
  "settings_schema": 1
}
