from typing import Any, Callable
def Header(title: str) -> dict[str, Any]: ...
def Text(title: str) -> dict[str, Any]: ...
def Switch(key: str, title: str, default: bool = False, scope: str = "global") -> dict[str, Any]: ...
def TextInput(key: str, title: str, default: str = "", max_length: int = 1000, scope: str = "global") -> dict[str, Any]: ...
def Select(key: str, title: str, options: list[dict[str, Any]], default: Any = None, scope: str = "global") -> dict[str, Any]: ...
def Slider(key: str, title: str, min: float = 0, max: float = 100, step: float = 1, default: float = 0, scope: str = "global") -> dict[str, Any]: ...
def Action(title: str, on_click: Callable[[], None]) -> dict[str, Any]: ...
