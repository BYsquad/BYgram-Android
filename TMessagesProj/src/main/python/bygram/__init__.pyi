from typing import Any, Callable
from .hooks import Hooks as _Hooks

SDK_VERSION: int
class Handle:
    def close(self) -> None: ...
class Settings:
    def get(self, key: str, default: Any = None) -> Any: ...
    def set(self, key: str, value: Any) -> None: ...
class _Log:
    def info(self, text: str) -> None: ...
    def warning(self, text: str) -> None: ...
    def error(self, text: str) -> None: ...
class _Storage:
    def read_text(self, path: str) -> str: ...
    def read_asset(self, path: str) -> str: ...
    def write_text(self, path: str, text: str) -> None: ...
class _Events:
    def subscribe(self, name: str, callback: Callable[[Any], None], account: int | None = None) -> Handle: ...
class _Work:
    def submit(self, callback: Callable[[], None]) -> Handle: ...
class _Theme:
    def override(self, key: str, value: int | str) -> Handle: ...
class _Network:
    def get_json(self, url: str) -> Any: ...
class UI:
    def run(self, callback: Callable[[], None]) -> None: ...
    def bulletin(self, text: str) -> None: ...
    def add_menu(self, location: str, id: str, title: str, on_click: Callable[[Any], None]) -> Handle: ...
    def open_page(self, page_spec: dict[str, Any]) -> None: ...
class Context:
    @property
    def accounts(self) -> tuple[int, ...]: ...
    @property
    def plugin_id(self) -> str: ...
    @property
    def version(self) -> str: ...
    @property
    def generation(self) -> int: ...
    settings: Settings
    ui: UI
    @property
    def migration_scope(self) -> str: ...
    log: _Log
    storage: _Storage
    events: _Events
    work: _Work
    theme: _Theme
    hooks: _Hooks
    network: _Network
    def account_settings(self, account: int) -> Settings: ...
    def client(self, account: int) -> Client: ...
class Client:
    account: int
    def send_text(self, peer: int, text: str) -> None: ...
    def draft_text(self, peer: int) -> str: ...
    def preview_text(self, peer: int, text: str) -> None: ...
class Plugin:
    context: Context
    def on_load(self) -> None: ...
    def on_enable(self) -> None: ...
    def on_disable(self) -> None: ...
    def on_unload(self) -> None: ...
    def create_settings(self) -> list[dict[str, Any]]: ...
    def migrate_settings(self, old_version: int, new_version: int, values: dict[str, Any]) -> dict[str, Any]: ...
