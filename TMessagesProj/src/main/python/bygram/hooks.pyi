from typing import Any, Callable, Sequence
from . import Handle
class HookCall:
    member: Any
    this_object: Any
    args: Any
    result: Any
    exception: Any
    def set_arg(self, index: int, value: Any) -> None: ...
    def set_result(self, value: Any) -> None: ...
    def set_exception(self, value: Any) -> None: ...
    def call_original(self) -> Any: ...
class Hooks:
    def method(self, class_name: str, method: str, args: Sequence[str] = (), before: Callable | None = None, after: Callable | None = None, priority: int = 0) -> Handle: ...
    def constructor(self, class_name: str, args: Sequence[str] = (), before: Callable | None = None, after: Callable | None = None, priority: int = 0) -> Handle: ...
    def replace(self, class_name: str, method: str, callback: Callable, args: Sequence[str] = (), priority: int = 0) -> Handle: ...
